NODE_ENV=production
PORT=4110
# MongoDB Atlas connection string (database name: gamehub)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gamehub?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
# Origins allowed to call the API with cookies (comma separated)
WEB_ORIGINS=https://gamehub.joura.info
# MiniGame Studio
MINIGAME_BASE_URL=https://minigame.joura.info
MINIGAME_API_KEY=mgs_xxx
MINIGAME_GAME_ID=lic_xxx
MINIGAME_WEBHOOK_SECRET=
# First admin (created on startup if missing)
ADMIN_EMAIL=admin@gamehub.demo
ADMIN_PASSWORD=change-me
